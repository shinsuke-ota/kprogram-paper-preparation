\newenvironment{qbox}[1]{ % qbox環境を定義して使いやすく
\begin{tcolorbox}[
       colframe = RoyalBlue,
       colback = RoyalBlue!10!White,
       title = {#1},
       fonttitle = \bfseries,
       breakable = true
    ]
}{
    \end{tcolorbox}
}

\newenvironment{codebox}[1]{ % qbox環境を定義して使いやすく
   \begin{tcolorbox}[
      colback = white,
      left = 20pt ,
       title = {#1},
       fonttitle = \bfseries,
       breakable = true
    ]
}{
    \end{tcolorbox}
}



\renewenvironment{itemize}{
   \begin{list}{\textbullet}{\topsep=1pt}
   \setlength{\parskip}{0cm} % 段落間
   \setlength{\itemsep}{0cm} % 項目間
 
}{
   \end{list}
}
\renewenvironment{enumerate}{
   \begin{list}{\arabic{enumi}.}{\usecounter{enumi}}
   \setlength{\parskip}{0cm} % 段落間
   \setlength{\itemsep}{0cm} % 項目間
 
}{
   \end{list}
}


