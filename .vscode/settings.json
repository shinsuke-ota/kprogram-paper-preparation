{
    "latex-workshop.latex.recipes": [
        {
            "name": "platex*2+dvipdfmx",
            "tools": [
                "platex",
                "platex",
                "dvipdfmx"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "platex",
